# App
APP_ENV=development
APP_NAME=x-meta-video
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_BASE_PATH=/api/v1

# Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_SECRET=change-me

# Database
DATABASE_URL=postgresql+psycopg://xmeta:xmeta@localhost:5432/xmeta_video

# Redis / Queue
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=xmeta-generation
WORKER_CONCURRENCY=2
TASK_STATUS_TTL_SECONDS=86400

# Object Storage: S3 / MinIO compatible
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=xmeta-video-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_EXPIRE_SECONDS=900

# Model Gateway
MODEL_PROVIDER_DEFAULT=mock
OPENAI_API_KEY=
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=
TTS_API_KEY=
TTS_BASE_URL=

# Security / CORS
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Observability
LOG_LEVEL=INFO
JSON_LOGS=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
