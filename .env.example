# App
APP_ENV=development
APP_NAME=x-meta-video
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_BASE_PATH=/api/v1

# Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_SECRET=change-me

# Database
DATABASE_URL=postgresql+psycopg://xmeta:xmeta@localhost:5432/xmeta_video

# Redis / Queue
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=xmeta-generation
WORKER_CONCURRENCY=2
TASK_STATUS_TTL_SECONDS=86400

# Object Storage: S3 / MinIO compatible
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=xmeta-video-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_EXPIRE_SECONDS=900

# Model Gateway
MODEL_PROVIDER_DEFAULT=mock
# Shared OpenAI credentials. Leave blank in committed files; local .env can fill only this key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Text model: used by Feature 3 Script Node when TEXT_MODEL_PROVIDER=openai.
TEXT_MODEL_PROVIDER=mock
TEXT_MODEL_BASE_URL=https://api.openai.com/v1
TEXT_MODEL_API_KEY=
TEXT_MODEL_NAME=gpt-5.4-mini
TEXT_MODEL_TEMPERATURE=
TEXT_MODEL_TIMEOUT_SECONDS=60
TEXT_MODEL_MAX_RETRIES=1

# Image/video/music are agent-layer configuration slots only until their nodes are implemented.
IMAGE_MODEL_PROVIDER=mock
IMAGE_MODEL_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL_API_KEY=
IMAGE_MODEL_NAME=gpt-image-1-mini
VIDEO_MODEL_PROVIDER=mock
VIDEO_MODEL_BASE_URL=https://api.openai.com/v1
VIDEO_MODEL_API_KEY=
VIDEO_MODEL_NAME=sora-2
MUSIC_MODEL_PROVIDER=mock
MUSIC_MODEL_BASE_URL=https://api.openai.com/v1
MUSIC_MODEL_API_KEY=
MUSIC_MODEL_NAME=
MUSIC_MODEL_IMPLEMENTATION_STATUS=config_only_no_openai_dedicated_music_endpoint

# Security / CORS
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Observability
LOG_LEVEL=INFO
JSON_LOGS=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
